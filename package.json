{
  "name": "droid-mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Unofficial Android client for Factory Droid (Capacitor + React + TypeScript).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodji7202-code/droid-mobile-android.git"
  },
  "homepage": "https://github.com/kodji7202-code/droid-mobile-android#readme",
  "bugs": {
    "url": "https://github.com/kodji7202-code/droid-mobile-android/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "server/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run --project unit --maxWorkers=4",
    "test:integration": "vitest run --project integration --maxWorkers=4 --passWithNoTests",
    "build": "npm run build --workspaces --if-present",
    "i18n:check": "vitest run --project unit apps/mobile/src/i18n/bundles.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/build-android.ps1 -Variant debug",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/build-android.ps1 -Variant release -Bundle",
    "android:keystore": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/new-release-keystore.ps1",
    "android:verify-release": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/verify-release.ps1",
    "docs:check": "node tools/dev/check-docs.mjs",
    "bundle:budget": "node tools/dev/check-bundle-budget.mjs",
    "scan:secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/scan-repo-secrets.ps1",
    "android:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/build-android.ps1 -Variant debug -SyncOnly",
    "android:check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/check-android-variants.ps1",
    "android:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/generate-android-icons.ps1",
    "android:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/emulator-start.ps1",
    "android:install": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/emulator-install.ps1",
    "android:cdp": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/emulator-forward-cdp.ps1 -Port 3150"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "axe-core": "4.11.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
