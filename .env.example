# Copy this file to .env.local (git-ignored) and fill in the values you need.
# Never commit real values. Load .env.local into a command without printing it with:
#   powershell -NoProfile -ExecutionPolicy Bypass -File tools\dev\with-env.ps1 <command> [args...]
#
# Everything below is optional unless a comment says otherwise. Variables are listed by the
# component that reads them.

# --- Factory credentials (integration tests, helper, dev scripts) ---------------------------
# Your own Factory API key (starts with fk-). The mobile app asks for it on the Connect screen
# and stores it in Android Keystore-backed storage; this variable is only for PC-side tooling:
# the integration tests, tools/dev scripts and `New-PairingCode -IncludeApiKey`.
FACTORY_API_KEY=

# --- Android build (tools/dev/build-android.ps1) --------------------------------------------
# Absolute path to the google-services.json of YOUR Firebase project. Only used when
# secrets/google-services.json does not exist. Without it the app builds, but push is disabled.
GOOGLE_SERVICES_JSON_PATH=

# Path to a keystore.properties file. Default: secrets/keystore.properties
# (read by apps/mobile/android/app/build.gradle).
DROID_KEYSTORE_PROPERTIES=

# --- Local toolchain overrides (tools/dev/env-android.ps1) ----------------------------------
# Folder with jdk-21, gradle-home and avd subfolders. Default: D:\droid-tools if it exists.
# When no jdk-21 is found there, the JAVA_HOME of your shell is used (must be JDK 21).
DROIDMOBILE_TOOLS_DIR=

# --- FCM bridge (server/fcm-bridge) ---------------------------------------------------------
# Absolute path to a Firebase service account JSON. Required unless BRIDGE_DRY_RUN=1.
FIREBASE_SERVICE_ACCOUNT_PATH=
# BRIDGE_DRY_RUN=1
# PORT=3102
# BRIDGE_HOST=127.0.0.1
# BRIDGE_DATA_DIR=./data
# BRIDGE_RATE_LIMIT_MAX=100
# BRIDGE_RATE_LIMIT_WINDOW_MS=60000
# BRIDGE_BODY_LIMIT_BYTES=65536
# BRIDGE_TRUST_PROXY=0
# BRIDGE_LOG_LEVEL=info

# --- PC helper (tools/pc-helper) ------------------------------------------------------------
# Path to droid.exe when it is neither on PATH nor in %USERPROFILE%\bin.
# DROIDMOBILE_DROID_EXE=
# Path to tailscale.exe when it is not on PATH or in %ProgramFiles%\Tailscale.
# DROIDMOBILE_TAILSCALE_EXE=
# State folder of the helper. Default: %LOCALAPPDATA%\DroidMobileHelper.
# DROIDMOBILE_HELPER_HOME=
# Bridge URL and pairing secret used by the Droid hook and `Doctor` (override bridge.json).
# DROIDMOBILE_BRIDGE_URL=https://bridge.example.com
# DROIDMOBILE_BRIDGE_SECRET=

# --- Integration tests (npm run test:integration) -------------------------------------------
# Daemon address for the integration tests. Default: ws://127.0.0.1:3101
# DC_TEST_DAEMON_URL=ws://127.0.0.1:3101
# droid.exe used by the reconnect test. Default: droid on PATH.
# DC_TEST_DROID_EXE=
