{
  "name": "@droidmobile/fcm-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Push bridge: receives Droid hook events and forwards opaque FCM notifications to registered phones.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "generate-secret": "tsx src/cli.ts generate-secret",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --root ../.. --project unit server/fcm-bridge"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
